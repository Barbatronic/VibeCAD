{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecad.local/schemas/vibecad-1.schema.json",
  "title": "Projet VibeCAD (format natif, schéma 1)",
  "description": "Fichier .vibecad : projet de CAO paramétrique (JSON UTF-8). Toutes les longueurs sont en millimètres.",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "document"
  ],
  "properties": {
    "format": {
      "const": "vibecad"
    },
    "schemaVersion": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "document": {
      "$ref": "#/$defs/document"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "length": {
      "type": "number",
      "minimum": 0
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "name",
        "units",
        "createdAt",
        "modifiedAt",
        "parts",
        "resources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "units": {
          "const": "mm"
        },
        "createdAt": {
          "type": "string"
        },
        "modifiedAt": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stepResource"
          }
        },
        "assembly": {
          "$ref": "#/$defs/assembly"
        },
        "fabrication": {
          "type": "object",
          "description": "Réglages de l'onglet Fabrication (impression 3D, découpe laser).",
          "properties": {
            "print": {
              "type": "object",
              "properties": {
                "bed": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "spacing": {
                  "type": "number"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "partId",
                      "copies",
                      "scale"
                    ],
                    "properties": {
                      "partId": {
                        "$ref": "#/$defs/id"
                      },
                      "copies": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "scale": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "downFace": {
                        "$ref": "#/$defs/faceRef"
                      }
                    }
                  }
                }
              },
              "description": "Impression 3D : les pièces qui ne tiennent pas sur un plateau passent sur le suivant (plateaux calculés, non enregistrés)."
            },
            "laser": {
              "type": "object",
              "properties": {
                "materials": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "thickness",
                      "sheet",
                      "kerf"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "name": {
                        "type": "string"
                      },
                      "thickness": {
                        "type": "number",
                        "minimum": 0
                      },
                      "sheet": {
                        "type": "object",
                        "properties": {
                          "w": {
                            "type": "number"
                          },
                          "h": {
                            "type": "number"
                          }
                        }
                      },
                      "kerf": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                },
                "spacing": {
                  "type": "number"
                },
                "engraveNames": {
                  "type": "boolean"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "partId",
                      "copies"
                    ],
                    "properties": {
                      "partId": {
                        "$ref": "#/$defs/id"
                      },
                      "copies": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "face": {
                        "$ref": "#/$defs/faceRef"
                      },
                      "materialId": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                },
                "sheet": {
                  "type": "object",
                  "properties": {
                    "w": {
                      "type": "number"
                    },
                    "h": {
                      "type": "number"
                    }
                  }
                },
                "thickness": {
                  "type": "number"
                },
                "kerf": {
                  "type": "number"
                }
              },
              "description": "Découpe laser : une « page » par matériau. Les champs sheet, thickness et kerf (une seule plaque) viennent des premières versions et sont convertis en un matériau à la lecture."
            }
          }
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "name",
        "color",
        "visible",
        "features"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "visible": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "params"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "sketch"
            },
            "visible": {
              "type": "boolean"
            },
            "params": {
              "$ref": "#/$defs/sketchParams"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "extrude"
            },
            "params": {
              "type": "object",
              "required": [
                "sketchId",
                "distance",
                "direction"
              ],
              "properties": {
                "sketchId": {
                  "$ref": "#/$defs/id"
                },
                "distance": {
                  "$ref": "#/$defs/length"
                },
                "direction": {
                  "$ref": "#/$defs/direction"
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "pocket"
            },
            "params": {
              "type": "object",
              "required": [
                "sketchId",
                "extent",
                "direction"
              ],
              "properties": {
                "sketchId": {
                  "$ref": "#/$defs/id"
                },
                "extent": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "throughAll"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "distance"
                      ],
                      "properties": {
                        "kind": {
                          "const": "distance"
                        },
                        "distance": {
                          "$ref": "#/$defs/length"
                        }
                      }
                    }
                  ]
                },
                "direction": {
                  "$ref": "#/$defs/direction"
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "imported-solid"
            },
            "params": {
              "type": "object",
              "required": [
                "resourceId",
                "solidIndex"
              ],
              "properties": {
                "resourceId": {
                  "$ref": "#/$defs/id"
                },
                "solidIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "fillet"
            },
            "params": {
              "type": "object",
              "required": [
                "edges",
                "radius"
              ],
              "properties": {
                "edges": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/edgeRef"
                  }
                },
                "radius": {
                  "$ref": "#/$defs/length"
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "chamfer"
            },
            "params": {
              "type": "object",
              "required": [
                "edges",
                "distance"
              ],
              "properties": {
                "edges": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/edgeRef"
                  }
                },
                "distance": {
                  "$ref": "#/$defs/length"
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "revolve"
            },
            "params": {
              "type": "object",
              "required": [
                "sketchId",
                "axis",
                "angle",
                "reversed"
              ],
              "properties": {
                "sketchId": {
                  "$ref": "#/$defs/id"
                },
                "axis": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "sketch-x",
                        "sketch-y",
                        "line"
                      ]
                    },
                    "lineId": {
                      "type": "string"
                    }
                  }
                },
                "angle": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 360,
                  "description": "degrés"
                },
                "reversed": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "pattern"
            },
            "params": {
              "type": "object",
              "required": [
                "sourceId",
                "kind",
                "axis",
                "count",
                "spacing",
                "angle",
                "reversed"
              ],
              "properties": {
                "sourceId": {
                  "$ref": "#/$defs/id"
                },
                "kind": {
                  "enum": [
                    "linear",
                    "circular"
                  ]
                },
                "axis": {
                  "$ref": "#/$defs/patternAxis"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "spacing": {
                  "type": "number",
                  "minimum": 0
                },
                "angle": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "reversed": {
                  "type": "boolean"
                },
                "second": {
                  "type": "object",
                  "required": [
                    "axis",
                    "count",
                    "spacing",
                    "reversed"
                  ],
                  "properties": {
                    "axis": {
                      "$ref": "#/$defs/patternAxis"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "spacing": {
                      "type": "number",
                      "minimum": 0
                    },
                    "reversed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "mirror"
            },
            "params": {
              "type": "object",
              "required": [
                "source",
                "plane"
              ],
              "properties": {
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "part"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "featureId"
                      ],
                      "properties": {
                        "kind": {
                          "const": "feature"
                        },
                        "featureId": {
                          "$ref": "#/$defs/id"
                        }
                      }
                    }
                  ]
                },
                "plane": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "plane"
                      ],
                      "properties": {
                        "kind": {
                          "const": "plane"
                        },
                        "plane": {
                          "enum": [
                            "XY",
                            "XZ",
                            "YZ"
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "ref"
                      ],
                      "properties": {
                        "kind": {
                          "const": "face"
                        },
                        "ref": {
                          "$ref": "#/$defs/faceRef"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "primitive"
            },
            "params": {
              "type": "object",
              "required": [
                "shape",
                "position",
                "width",
                "depth",
                "height",
                "diameter",
                "thickness",
                "operation"
              ],
              "properties": {
                "shape": {
                  "enum": [
                    "box",
                    "cylinder",
                    "sphere",
                    "torus"
                  ]
                },
                "position": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                },
                "depth": {
                  "type": "number",
                  "minimum": 0
                },
                "height": {
                  "type": "number",
                  "minimum": 0
                },
                "diameter": {
                  "type": "number",
                  "minimum": 0
                },
                "thickness": {
                  "type": "number",
                  "minimum": 0
                },
                "operation": {
                  "enum": [
                    "add",
                    "cut"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "shell"
            },
            "params": {
              "type": "object",
              "required": [
                "open",
                "thickness",
                "outward"
              ],
              "properties": {
                "open": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/faceRef"
                  }
                },
                "thickness": {
                  "type": "number",
                  "minimum": 0
                },
                "outward": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "loft"
            },
            "params": {
              "type": "object",
              "required": [
                "sketchIds",
                "ruled",
                "operation"
              ],
              "properties": {
                "sketchIds": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "ruled": {
                  "type": "boolean"
                },
                "operation": {
                  "enum": [
                    "add",
                    "cut"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "sweep"
            },
            "params": {
              "type": "object",
              "required": [
                "profileId",
                "pathId",
                "operation"
              ],
              "properties": {
                "profileId": {
                  "$ref": "#/$defs/id"
                },
                "pathId": {
                  "$ref": "#/$defs/id"
                },
                "operation": {
                  "enum": [
                    "add",
                    "cut"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "direction": {
      "enum": [
        "default",
        "reversed",
        "symmetric"
      ]
    },
    "faceRef": {
      "type": "object",
      "required": [
        "featureId",
        "role"
      ],
      "properties": {
        "featureId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "start",
            "end",
            "side",
            "imported",
            "blend"
          ]
        },
        "entityId": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sketchParams": {
      "type": "object",
      "required": [
        "support",
        "entities",
        "constraints"
      ],
      "properties": {
        "support": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "plane"
              ],
              "properties": {
                "kind": {
                  "const": "plane"
                },
                "plane": {
                  "enum": [
                    "XY",
                    "XZ",
                    "YZ"
                  ]
                },
                "offset": {
                  "type": "number"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "const": "face"
                },
                "ref": {
                  "$ref": "#/$defs/faceRef"
                }
              }
            }
          ]
        },
        "entities": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "x",
                  "y"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "point"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "a",
                  "b"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "line"
                  },
                  "a": {
                    "type": "string"
                  },
                  "b": {
                    "type": "string"
                  },
                  "construction": {
                    "type": "boolean",
                    "description": "Trait de construction : ignoré pour le volume."
                  },
                  "reference": {
                    "type": "object",
                    "required": [
                      "edge"
                    ],
                    "description": "Arête de la pièce projetée (élément fixe, recalculé).",
                    "properties": {
                      "edge": {
                        "$ref": "#/$defs/edgeRef"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "center",
                  "radius"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "circle"
                  },
                  "center": {
                    "type": "string"
                  },
                  "radius": {
                    "$ref": "#/$defs/length"
                  },
                  "construction": {
                    "type": "boolean",
                    "description": "Trait de construction : ignoré pour le volume."
                  },
                  "reference": {
                    "type": "object",
                    "required": [
                      "edge"
                    ],
                    "description": "Arête de la pièce projetée (élément fixe, recalculé).",
                    "properties": {
                      "edge": {
                        "$ref": "#/$defs/edgeRef"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "center",
                  "start",
                  "end"
                ],
                "description": "Arc de start à end, sens trigonométrique autour de center.",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "arc"
                  },
                  "center": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  },
                  "construction": {
                    "type": "boolean"
                  },
                  "reference": {
                    "type": "object",
                    "required": [
                      "edge"
                    ],
                    "properties": {
                      "edge": {
                        "$ref": "#/$defs/edgeRef"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "coincident",
                  "horizontal",
                  "vertical",
                  "length",
                  "distance",
                  "distanceX",
                  "distanceY",
                  "diameter",
                  "radius",
                  "parallel",
                  "perpendicular",
                  "collinear",
                  "equal",
                  "tangent",
                  "pointOn",
                  "midpoint",
                  "angle",
                  "pointLineDistance"
                ]
              },
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "circle": {
                "type": "string"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "description": "mm, ou degrés pour un angle"
              },
              "offset": {
                "type": "number"
              },
              "point": {
                "type": "string"
              },
              "curve": {
                "type": "string"
              },
              "internal": {
                "type": "boolean"
              },
              "supplementary": {
                "type": "boolean"
              },
              "labelAngle": {
                "type": "number",
                "description": "direction du libellé (diamètre, rayon), degrés"
              }
            }
          }
        }
      }
    },
    "stepResource": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "fileName",
        "encoding",
        "data",
        "byteLength",
        "sha256",
        "importedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "step"
        },
        "fileName": {
          "type": "string"
        },
        "encoding": {
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "data": {
          "type": "string"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "importedAt": {
          "type": "string"
        }
      }
    },
    "edgeRef": {
      "type": "object",
      "required": [
        "faces"
      ],
      "properties": {
        "faces": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/faceRef"
          }
        }
      }
    },
    "lcs": {
      "type": "object",
      "required": [
        "kind"
      ],
      "description": "Repère local : centre de face (face), centre de cercle (circle), milieu d'arête droite (edge) ou sommet d'une face plane (vertex : la face et deux de ses arêtes).",
      "properties": {
        "kind": {
          "enum": [
            "face",
            "circle",
            "edge",
            "vertex"
          ]
        },
        "face": {
          "$ref": "#/$defs/faceRef"
        },
        "edge": {
          "$ref": "#/$defs/edgeRef"
        },
        "edges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/edgeRef"
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "required": [
        "instances",
        "joints"
      ],
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "partId",
              "name",
              "position"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "partId": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "position": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind",
              "moving",
              "base",
              "flip",
              "angle",
              "offset"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "fixed",
                  "revolute",
                  "slider",
                  "cylindrical",
                  "spherical"
                ]
              },
              "moving": {
                "$ref": "#/$defs/jointEnd"
              },
              "base": {
                "$ref": "#/$defs/jointEnd"
              },
              "flip": {
                "type": "boolean"
              },
              "angle": {
                "type": "number",
                "description": "degrés"
              },
              "offset": {
                "type": "number",
                "description": "mm"
              },
              "angleLimits": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "offsetLimits": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "tilt": {
                "type": "number",
                "description": "Rotule : inclinaison (degrés)."
              },
              "tiltDirection": {
                "type": "number",
                "description": "Rotule : direction de l'inclinaison (degrés, autour de l'axe du repère de référence)."
              },
              "tiltLimit": {
                "type": "number",
                "minimum": 0,
                "maximum": 180,
                "description": "Rotule : inclinaison maximale (degrés)."
              }
            }
          }
        }
      }
    },
    "jointEnd": {
      "type": "object",
      "required": [
        "instanceId",
        "lcs"
      ],
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "lcs": {
          "$ref": "#/$defs/lcs"
        }
      }
    },
    "patternAxis": {
      "description": "Direction ou axe d'une répétition : axe du repère passant par l'origine, ou arête de la pièce (droite : direction ; cercle : son axe).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "axis"
          ],
          "properties": {
            "kind": {
              "const": "axis"
            },
            "axis": {
              "enum": [
                "X",
                "Y",
                "Z"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "edge"
          ],
          "properties": {
            "kind": {
              "const": "edge"
            },
            "edge": {
              "$ref": "#/$defs/edgeRef"
            }
          }
        }
      ]
    }
  }
}
